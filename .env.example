# Copy this file to .env for local use, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables. Never commit .env.

# --- Prodigi (print supplier) ---
# "sandbox" prints nothing and costs nothing. Switch to "live" when you go live
# (and swap in your live API key).
PRODIGI_ENV=sandbox
PRODIGI_API_KEY=

# Prodigi bills you in this currency, and FX_RATE is how many rand 1 unit of it is
# worth. Shipping is quoted by Prodigi in this currency and converted to rand.
# Update FX_RATE now and then (or leave a healthy SHIPPING_MARKUP).
PRODIGI_CURRENCY=GBP
FX_RATE=24
# Extra on top of Prodigi's shipping cost, to absorb exchange-rate swings (0.15 = 15%).
SHIPPING_MARKUP=0.15
# Budget | Standard | StandardPlus | Express | Overnight
SHIPPING_METHOD=Standard

# --- Paystack (payments) ---
# sk_test_... while testing, sk_live_... once your business is verified.
PAYSTACK_SECRET_KEY=

# --- Your site ---
# Where Paystack sends customers after paying, e.g. https://your-site.vercel.app
# (leave blank to auto-detect the address the visitor used).
SITE_URL=
