# Copy this file to .env for local use (npm run gelato-products). Never commit .env.
# On Cloudflare, secrets go in the dashboard and other settings in wrangler.toml;
# for npm run dev, put the secrets in .dev.vars.

# --- Gelato (print supplier) ---
# Gelato dashboard -> Developer -> API keys.
GELATO_API_KEY=
# "draft" creates draft orders that Gelato never prints or charges for. "live" prints for real.
GELATO_MODE=draft
GELATO_CURRENCY=EUR
# Rand per 1 EUR, used to turn Gelato's delivery price into rand.
FX_RATE=19
# Extra on top of Gelato's delivery price, to absorb exchange-rate swings (0.15 = 15%).
SHIPPING_MARKUP=0.15

# --- Paystack (payments) ---
# sk_test_... while testing, sk_live_... once your business is verified.
PAYSTACK_SECRET_KEY=

# --- Order emails (optional) ---
EMAILJS_PRIVATE_KEY=
